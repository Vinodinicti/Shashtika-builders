# =========================================================================
# SHASHTIKA BUILDERS & PROMOTERS - BACKEND CONFIGURATION
# =========================================================================

# Port for Express API Server
PORT=5000

# MongoDB Connection String:
# 1. MongoDB Atlas (Cloud - Recommended):
#    MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/shashtika_db?retryWrites=true&w=majority
#
# 2. Local MongoDB:
#    MONGODB_URI=mongodb://127.0.0.1:27017/shashtika_db

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shashtika_db?retryWrites=true&w=majority
